# Client-visible Supabase values only. These are protected by RLS, not secrecy.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only values such as OPENAI_API_KEY and Supabase service-role credentials
# belong in Supabase Edge Function / deployment secrets and must never use EXPO_PUBLIC_*.
